name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: Fully qualified name for the output artifact to be used as input
        type: string

      output_artifact:
        description: Fully qualified name for the output artifact to be created
        type: string

      output_type:
        description: Type of the output artifact to be created
        type: string

      output_description:
        description: Description for the artifact to be created
        type: string

      min_price:
        description: Minimum price to process
        type: string

      max_price:
        description: Maximum price to process
        type: string


    command: >-
        python run.py  --input_artifact {input_artifact}  --output_artifact {output_artifact}  --output_type {output_type}  --output_description {output_description}  --min_price {min_price}  --max_price {max_price} 
