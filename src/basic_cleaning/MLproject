name: basic_cleaning
conda_env: conda.yml
entry_points:
  main:
    parameters:

      input_artifact:
        description: "Input artifact str"
        type: string

      output_artifact:
        description: "Output artifact str"
        type: string

      output_type:
        description: "Output type str"
        type: string

      output_description:
        description: "Output description str"
        type: string

      min_price:
        description: "Min price float"
        type: float

      max_price:
        description: "Max price float"
        type: float


    command: >-
        python run.py  --input_artifact {input_artifact}  --output_artifact {output_artifact}
        --output_type {output_type} --output_description {output_description}
        --min_price {min_price} --max_price {max_price}
